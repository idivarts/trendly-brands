{
    "cli": {
        "version": ">= 16.6.2",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development"
        },
        "preview": {
            "channel": "preview",
            "ios": {
                "simulator": true
            }
        },
        "simulator": {
            "channel": "development",
            "ios": {
                "simulator": true,
                "buildConfiguration": "Debug"
            },
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "autoIncrement": true,
            "node": "20.11.1",
            "channel": "production",
            "android": {
                "buildType": "app-bundle"
            }
        },
        "production-dev": {
            "autoIncrement": true,
            "node": "20.11.1",
            "channel": "development",
            "android": {
                "buildType": "app-bundle"
            }
        },
        "production-apk": {
            "node": "20.11.1",
            "channel": "production",
            "android": {
                "buildType": "apk"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleId": "rahul.sinha1908@gmail.com",
                "ascAppId": "6736949941"
            },
            "android": {
                "serviceAccountKeyPath": "./play-console-service-account.json",
                "track": "production",
                "releaseStatus": "draft",
                "changesNotSentForReview": true
            }
        },
        "development": {
            "ios": {
                "appleId": "rahul.sinha1908@gmail.com",
                "ascAppId": "6736949941"
            },
            "android": {
                "serviceAccountKeyPath": "./play-console-service-account.json",
                "track": "internal"
            }
        }
    }
}