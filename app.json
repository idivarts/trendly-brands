{
    "expo": {
        "name": "Trendly - AI Social Planner",
        "slug": "trendly-brands",
        "version": "4.1.0",
        "orientation": "portrait",
        "icon": "./assets/images/branding/app-icon.png",
        "scheme": "trendly-brands",
        "platforms": [
            "ios",
            "android",
            "web"
        ],
        "runtimeVersion": {
            "policy": "fingerprint"
        },
        "updates": {
            "url": "https://u.expo.dev/7939ee56-e9dc-45ad-9c84-461a884e011f",
            "enabled": true,
            "checkAutomatically": "ON_LOAD",
            "fallbackToCacheTimeout": 0
        },
        "jsEngine": "hermes",
        "userInterfaceStyle": "automatic",
        "splash": {
            "image": "./assets/images/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff",
            "dark": {
                "image": "./assets/images/splash-dark.png",
                "resizeMode": "contain",
                "backgroundColor": "#000000"
            }
        },
        "ios": {
            "usesAppleSignIn": true,
            "supportsTablet": false,
            "bundleIdentifier": "pro.trendly.brands",
            "googleServicesFile": "./GoogleService-Info.plist",
            "associatedDomains": [
                "applinks:zgh4c.app.link",
                "applinks:zgh4c-alternate.app.link",
                "applinks:zgh4c.test-app.link",
                "applinks:zgh4c-alternate.test-app.link"
            ],
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false,
                "CFBundleDisplayName": "Trendly AI",
                "NSPhotoLibraryAddUsageDescription": "Trendly needs permission to add to your photo library so it can save content you create in the app. For example, you can download a post image you designed in Trendly and keep it on your device to re-use elsewhere.",
                "NSUserNotificationUsageDescription": "Trendly would like to send you notifications about your scheduled posts, publishing results, and important activity on your account.",
                "NSUserTrackingUsageDescription": "Trendly uses this to measure which ads and referral links led to app installs and sign-ups, so we can improve how we reach new users. For example, if you install Trendly after tapping one of our ads, this lets us attribute that install to the right campaign."
            },
            "appleTeamId": "8UTA9QW6TV"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/branding/app-icon.png",
                "backgroundColor": "#ffffff"
            },
            "package": "pro.trendly.brands",
            "googleServicesFile": "./google-services.json",
            "intentFilters": [
                {
                    "action": "VIEW",
                    "autoVerify": true,
                    "category": [
                        "BROWSABLE",
                        "DEFAULT"
                    ],
                    "data": [
                        { "scheme": "https", "host": "zgh4c.app.link" },
                        { "scheme": "https", "host": "zgh4c-alternate.app.link" },
                        { "scheme": "https", "host": "zgh4c.test-app.link" },
                        { "scheme": "https", "host": "zgh4c-alternate.test-app.link" }
                    ]
                }
            ],
            "permissions": [
                "NOTIFICATIONS",
                "CAMERA",
                "RECORD_AUDIO",
                "READ_EXTERNAL_STORAGE",
                "WRITE_EXTERNAL_STORAGE",
                "ACCESS_MEDIA_LOCATION",
                "MODIFY_AUDIO_SETTINGS",
                "ACCESS_COARSE_LOCATION",
                "ACCESS_FINE_LOCATION",
                "android.permission.CAMERA",
                "android.permission.RECORD_AUDIO",
                "android.permission.MODIFY_AUDIO_SETTINGS",
                "android.permission.ACCESS_COARSE_LOCATION",
                "android.permission.ACCESS_FINE_LOCATION",
                "android.permission.READ_EXTERNAL_STORAGE",
                "android.permission.WRITE_EXTERNAL_STORAGE",
                "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
                "android.permission.ACCESS_MEDIA_LOCATION",
                "android.permission.READ_MEDIA_AUDIO"
            ]
        },
        "web": {
            "bundler": "metro",
            "output": "single",
            "favicon": "./assets/images/branding/trendly-symbol.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "android": {
                        "image": "./assets/images/branding/trendly-primary-horizontal-navy.png",
                        "imageWidth": 180,
                        "backgroundColor": "#ffffff",
                        "dark": {
                            "image": "./assets/images/branding/trendly-primary-horizontal-white.png",
                            "backgroundColor": "#000000"
                        }
                    }
                }
            ],
            "expo-apple-authentication",
            [
                "expo-build-properties",
                {
                    "ios": {
                        "useFrameworks": "static",
                        "buildReactNativeFromSource": true
                    }
                }
            ],
            "./plugins/with-ios-fmt-xcode26-fix.js",
            "./plugins/with-android-gradle-memory.js",
            "expo-notifications",
            "@react-native-google-signin/google-signin",
            [
                "expo-camera",
                {
                    "cameraPermission": "Trendly needs access to your camera so you can capture photos and videos inside the app to use in your social media posts. For example, you can record a short product clip and publish it as an Instagram Reel from Trendly.",
                    "microphonePermission": "Trendly needs access to your microphone to record audio together with videos you capture in the app, and to record voiceovers for your posts. For example, you can narrate a product video before scheduling it to your social accounts.",
                    "recordAudioAndroid": true
                }
            ],
            [
                "expo-image-picker",
                {
                    "photosPermission": "Trendly needs access to your photo library so you can pick your own photos and videos to use in the social media posts you create. For example, you can select a product photo from your library and attach it to an Instagram post you are scheduling in Trendly.",
                    "cameraPermission": "Trendly needs access to your camera so you can capture photos and videos inside the app to use in your social media posts. For example, you can record a short product clip and publish it as an Instagram Reel from Trendly.",
                    "microphonePermission": "Trendly needs access to your microphone to record audio together with videos you capture in the app, and to record voiceovers for your posts. For example, you can narrate a product video before scheduling it to your social accounts."
                }
            ],
            [
                "expo-av",
                {
                    "microphonePermission": "Trendly needs access to your microphone to record audio together with videos you capture in the app, and to record voiceovers for your posts. For example, you can narrate a product video before scheduling it to your social accounts."
                }
            ],
            [
                "expo-document-picker",
                {
                    "iCloudContainerEnvironment": "Production"
                }
            ],
            [
                "expo-location",
                {
                    "locationWhenInUsePermission": "Trendly needs access to your location only when you create an on-site campaign, so it can center the map on where you are. For example, when you set a campaign at your store, Trendly places it on the map at your current location so creators see the correct address.",
                    "locationAlwaysPermission": false,
                    "locationAlwaysAndWhenInUsePermission": false
                }
            ],
            "expo-tracking-transparency",
            "expo-audio",
            "expo-video",
            "expo-localization",
            "./plugins/with-branch.js"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {
                "origin": false
            },
            "eas": {
                "projectId": "7939ee56-e9dc-45ad-9c84-461a884e011f"
            }
        },
        "owner": "idiv"
    }
}