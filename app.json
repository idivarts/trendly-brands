{
    "expo": {
        "name": "Trendly - AI Social Planner",
        "slug": "trendly-brands",
        "version": "4.1.0",
        "orientation": "portrait",
        "icon": "./assets/images/branding/app-icon.png",
        "scheme": "trendly-brands",
        "platforms": [
            "ios",
            "android",
            "web"
        ],
        "runtimeVersion": {
            "policy": "fingerprint"
        },
        "updates": {
            "url": "https://u.expo.dev/7939ee56-e9dc-45ad-9c84-461a884e011f",
            "enabled": true,
            "checkAutomatically": "ON_LOAD",
            "fallbackToCacheTimeout": 0
        },
        "jsEngine": "hermes",
        "userInterfaceStyle": "automatic",
        "splash": {
            "image": "./assets/images/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff",
            "dark": {
                "image": "./assets/images/splash-dark.png",
                "resizeMode": "contain",
                "backgroundColor": "#000000"
            }
        },
        "ios": {
            "usesAppleSignIn": true,
            "supportsTablet": false,
            "bundleIdentifier": "pro.trendly.brands",
            "googleServicesFile": "./GoogleService-Info.plist",
            "associatedDomains": [
                "applinks:zgh4c.app.link",
                "applinks:zgh4c-alternate.app.link",
                "applinks:zgh4c.test-app.link",
                "applinks:zgh4c-alternate.test-app.link"
            ],
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false,
                "CFBundleDisplayName": "Trendly AI",
                "NSPhotoLibraryAddUsageDescription": "Trendly saves content you create to your photo library, such as a post image you designed in Trendly that you want to keep on your device.",
                "NSUserNotificationUsageDescription": "Trendly would like to send you notifications about your scheduled posts, publishing results, and important activity on your account.",
                "NSUserTrackingUsageDescription": "Trendly uses this to measure which ads and links led to app installs, such as attributing your install to the campaign you tapped."
            },
            "appleTeamId": "8UTA9QW6TV"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/branding/app-icon.png",
                "backgroundColor": "#ffffff"
            },
            "package": "pro.trendly.brands",
            "googleServicesFile": "./google-services.json",
            "intentFilters": [
                {
                    "action": "VIEW",
                    "autoVerify": true,
                    "category": [
                        "BROWSABLE",
                        "DEFAULT"
                    ],
                    "data": [
                        { "scheme": "https", "host": "zgh4c.app.link" },
                        { "scheme": "https", "host": "zgh4c-alternate.app.link" },
                        { "scheme": "https", "host": "zgh4c.test-app.link" },
                        { "scheme": "https", "host": "zgh4c-alternate.test-app.link" }
                    ]
                }
            ],
            "permissions": [
                "NOTIFICATIONS",
                "CAMERA",
                "RECORD_AUDIO",
                "READ_EXTERNAL_STORAGE",
                "WRITE_EXTERNAL_STORAGE",
                "ACCESS_MEDIA_LOCATION",
                "MODIFY_AUDIO_SETTINGS",
                "ACCESS_COARSE_LOCATION",
                "ACCESS_FINE_LOCATION",
                "android.permission.CAMERA",
                "android.permission.RECORD_AUDIO",
                "android.permission.MODIFY_AUDIO_SETTINGS",
                "android.permission.ACCESS_COARSE_LOCATION",
                "android.permission.ACCESS_FINE_LOCATION",
                "android.permission.READ_EXTERNAL_STORAGE",
                "android.permission.WRITE_EXTERNAL_STORAGE",
                "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
                "android.permission.ACCESS_MEDIA_LOCATION",
                "android.permission.READ_MEDIA_AUDIO"
            ]
        },
        "web": {
            "bundler": "metro",
            "output": "single",
            "favicon": "./assets/images/branding/trendly-symbol.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "android": {
                        "image": "./assets/images/branding/trendly-primary-horizontal-navy.png",
                        "imageWidth": 180,
                        "backgroundColor": "#ffffff",
                        "dark": {
                            "image": "./assets/images/branding/trendly-primary-horizontal-white.png",
                            "backgroundColor": "#000000"
                        }
                    }
                }
            ],
            "expo-apple-authentication",
            [
                "expo-build-properties",
                {
                    "ios": {
                        "useFrameworks": "static",
                        "buildReactNativeFromSource": true
                    }
                }
            ],
            "./plugins/with-ios-fmt-xcode26-fix.js",
            "./plugins/with-android-gradle-memory.js",
            "expo-notifications",
            "@react-native-google-signin/google-signin",
            [
                "expo-camera",
                {
                    "cameraPermission": "Trendly uses your camera so you can shoot photos and videos in the app for your posts, such as recording a product clip to publish as an Instagram Reel.",
                    "microphonePermission": "Trendly uses your microphone to record sound with videos you shoot in the app and voiceovers for your posts, such as narrating a product video before you schedule it.",
                    "recordAudioAndroid": true
                }
            ],
            [
                "expo-image-picker",
                {
                    "photosPermission": "Trendly uses your photo library so you can pick your own photos and videos for the posts you create, such as adding a product photo to an Instagram post you are scheduling.",
                    "cameraPermission": "Trendly uses your camera so you can shoot photos and videos in the app for your posts, such as recording a product clip to publish as an Instagram Reel.",
                    "microphonePermission": "Trendly uses your microphone to record sound with videos you shoot in the app and voiceovers for your posts, such as narrating a product video before you schedule it."
                }
            ],
            [
                "expo-av",
                {
                    "microphonePermission": "Trendly uses your microphone to record sound with videos you shoot in the app and voiceovers for your posts, such as narrating a product video before you schedule it."
                }
            ],
            [
                "expo-document-picker",
                {
                    "iCloudContainerEnvironment": "Production"
                }
            ],
            [
                "expo-location",
                {
                    "locationWhenInUsePermission": "Trendly uses your location only when you create an on-site campaign, to center the map on where you are, such as placing a campaign at your store address.",
                    "locationAlwaysPermission": false,
                    "locationAlwaysAndWhenInUsePermission": false
                }
            ],
            "expo-tracking-transparency",
            "expo-audio",
            "expo-video",
            "expo-localization",
            "./plugins/with-branch.js"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {
                "origin": false
            },
            "eas": {
                "projectId": "7939ee56-e9dc-45ad-9c84-461a884e011f"
            }
        },
        "owner": "idiv"
    }
}